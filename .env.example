# Copy this file to .env. The real .env is git-ignored and stays on your computer.
# Required only for Gemini meal-image generation. Never expose this in browser code.
GEMINI_API_KEY=

# Optional server-side WhatsApp delivery through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TO=
